APP_NAME=CareerAgent
APP_ENV=development
DATABASE_URL=sqlite:///./data/career_agent.db

# OpenAI-compatible LLM 接口。不要提交真实密钥。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_ROUTING_ENABLED=true
LLM_FLASH_MODEL=deepseek-v4-flash
LLM_PRO_MODEL=deepseek-v4-pro
LLM_FLASH_TRACE_PREFIXES=natural_language.,resume_parser.,jd_parser.,evaluation.llm_judge_suitability,resume_tailor.,application.
LLM_PRO_TRACE_PREFIXES=resume_review.,interview_prep.,interview_agentic_rag.
# Flash 较便宜，允许结构化/短文本节点使用比调用方请求高 15% 的 completion 上限；不增加业务 repair 轮数。
LLM_FLASH_MAX_TOKENS_MULTIPLIER=1.15
LLM_RETRY_ATTEMPTS=1
LLM_RETRY_BACKOFF_SECONDS=0.75
LLM_FALLBACK_ENABLED=false
LLM_THINKING_MODE=auto
LLM_REASONING_EFFORT=high
LLM_CONTEXT_COMPRESSION_ENABLED=true
LLM_CONTEXT_MAX_CHARS=9000
LLM_EVIDENCE_MAX_CHARS=3600
INTERVIEW_RAG_MAX_QUESTIONS=10
INTERVIEW_RAG_ANSWER_BATCH_SIZE=10
INTERVIEW_RAG_LLM_CONCURRENCY=2
INTERVIEW_RAG_VERIFY_QUESTION_BATCH_SIZE=10
INTERVIEW_RAG_VERIFY_MAX_TOKENS=2800
INTERVIEW_RAG_JSON_REPAIR_ATTEMPTS=0
INTERVIEW_RAG_RETRIEVAL_TOP_N=20
INTERVIEW_RAG_EVIDENCE_TOP_K=5
INTERVIEW_RAG_EVIDENCE_CHARS=360
INTERVIEW_RAG_ANSWER_REPAIR_ATTEMPTS=1
INTERVIEW_RAG_MAX_LLM_CALLS=5
INTERVIEW_RAG_MAX_PROMPT_CHARS=60000
INTERVIEW_RAG_MAX_COMPLETION_TOKENS=15000
ADMIN_API_KEY=
REQUIRE_ADMIN_FOR_MUTATIONS=false

UPLOAD_DIR=data/uploads
EXPORT_DIR=data/exports
CHROMA_DIR=data/chroma
CHUNK_SIZE=900
CHUNK_OVERLAP=160
EMBEDDING_DIMENSIONS=256
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_PROVIDER_FALLBACK=error
VECTOR_BACKEND=hybrid
RERANKER_ENABLED=true
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_PROVIDER_FALLBACK=error
RERANKER_TOP_N=20
RERANKER_ANCHOR_TOP_N=5
JOB_INGEST_CONCURRENCY=6
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=career_agent:runs
REDIS_DEAD_LETTER_QUEUE_NAME=career_agent:runs:dead_letter
REDIS_RUN_LOCK_TTL_SECONDS=1800
REDIS_HEARTBEAT_TTL_SECONDS=300
REDIS_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_RATE_LIMIT_MAX_RUNS=10
REDIS_WORKER_MAX_ATTEMPTS=3
REDIS_QUEUED_RECOVERY_AFTER_MINUTES=5
AGENT_RUN_STALE_AFTER_MINUTES=30
AGENT_ACTIVE_RUN_LIMIT_PER_PROFILE=3

# 可选岗位源配置。
TENCENT_CAREERS_ENABLED=true
BAIDU_CAREERS_ENABLED=true
MEITUAN_CAREERS_ENABLED=true
BYTEDANCE_CAREERS_ENABLED=true
ALIBABA_CAREERS_ENABLED=true
JOB_SOURCE_BROWSER_HEADLESS=true
JOB_SOURCE_BROWSER_TIMEOUT_MS=30000
LEVER_CAREERS_ENABLED=false
LEVER_COMPANY_SLUGS=anthropic,cohere,scaleai,perplexityai
