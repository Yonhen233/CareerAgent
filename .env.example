APP_NAME=CareerAgent
APP_ENV=development
DATABASE_URL=sqlite:///./data/career_agent.db

# OpenAI-compatible LLM 接口。不要提交真实密钥。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_ROUTING_ENABLED=true
LLM_FLASH_MODEL=deepseek-v4-flash
LLM_PRO_MODEL=deepseek-v4-pro
LLM_FLASH_TRACE_PREFIXES=natural_language.,resume_parser.,jd_parser.,evaluation.llm_judge_suitability,resume_tailor.,application.
LLM_PRO_TRACE_PREFIXES=resume_review.,interview_prep.,interview_agentic_rag.
# Flash 较便宜，允许结构化/短文本节点使用比调用方请求高 15% 的 completion 上限；不增加业务 repair 轮数。
AGENT_MAX_TOOL_STEPS=48
AGENT_MAX_IDENTICAL_TOOL_CALLS=2
AGENT_MAX_NO_PROGRESS_CYCLES=2
AGENT_STRICT_TOOL_CONTRACTS=true
AGENT_TOOL_RETRY_BACKOFF_SECONDS=0.4
AGENT_TOOL_CIRCUIT_FAILURE_THRESHOLD=3
AGENT_TOOL_CIRCUIT_COOLDOWN_SECONDS=60
AGENT_ONLINE_QUALITY_MIN_SCORE=0.75
AGENT_MEMORY_CONTEXT_MAX_ITEMS=12
AGENT_MEMORY_CONTEXT_MAX_CHARS=1600
DIAGNOSTIC_REDACT_PII=true
RAG_MULTI_QUERY_ENABLED=true
RAG_MULTI_QUERY_RRF_K=60
RAG_MIN_EVIDENCE_CHUNKS=1
RAG_MIN_VECTOR_SCORE=0.50
RAG_MIN_QUERY_COVERAGE=0.10
RAG_MIN_FIRST_STAGE_SCORE=0.45
# 仅用于离线测试的 hash embedding；生产 release gate 不接受 hash provider。
RAG_HASH_MIN_VECTOR_SCORE=0.28
RAG_HASH_MIN_FIRST_STAGE_SCORE=0.30
NATURAL_AGENT_MAX_LLM_CALLS=12
NATURAL_AGENT_MAX_PROMPT_CHARS=140000
NATURAL_AGENT_MAX_COMPLETION_TOKENS=32000
LLM_FLASH_MAX_TOKENS_MULTIPLIER=1.15
LLM_RETRY_ATTEMPTS=1
LLM_RETRY_BACKOFF_SECONDS=0.75
LLM_FALLBACK_ENABLED=false
LLM_THINKING_MODE=auto
LLM_REASONING_EFFORT=high
LLM_CONTEXT_COMPRESSION_ENABLED=true
LLM_CONTEXT_MAX_CHARS=9000
LLM_EVIDENCE_MAX_CHARS=3600
# Context Runtime V2 先以 Shadow Mode 采集差异；真实 LLM A/B 门禁通过前不要直接切默认。
CONTEXT_RUNTIME_V2_ENABLED=true
CONTEXT_RUNTIME_V2_SHADOW_MODE=false
CONTEXT_MANAGEMENT_V3_ENABLED=true
TOKEN_OPTIMIZATION_V2_ENABLED=true
TOKEN_OPTIMIZATION_SHADOW_MODE=false
CONVERSATION_RECENT_TURNS=3
CONVERSATION_COMPACTION_BUDGET_RATIO=0.25
CONVERSATION_COMPACTOR_MAX_TOKENS=1200
PARSER_DOCUMENT_BATCH_CHARS=16000
DYNAMIC_TOOL_CATALOG_ENABLED=true
BATCH_TOOL_CALLS_ENABLED=true
PARALLEL_TOOL_CALLS_ENABLED=true
TOOL_RESULT_ARTIFACT_ENABLED=true
DELTA_CONTEXT_ENABLED=true
LLM_MAX_CALLS_PER_RUN=12
LLM_MAX_ATTEMPTS_PER_RUN=18
LLM_MAX_REPAIR_CALLS=2
LLM_MAX_INPUT_TOKENS_PER_RUN=120000
LLM_MAX_OUTPUT_TOKENS_PER_RUN=40000
LLM_MAX_TOTAL_TOKENS_PER_RUN=160000
CONTEXT_MODEL_WINDOW_TOKENS=65536
CONTEXT_TOKEN_SOFT_LIMIT_RATIO=0.70
CONTEXT_TOKEN_HIGH_LIMIT_RATIO=0.85
CONTEXT_TOKEN_HARD_LIMIT_RATIO=0.95
CONTEXT_OUTPUT_RESERVE_TOKENS=4096
CONTEXT_SAFETY_MARGIN_TOKENS=1024
CONTEXT_TOOL_SCHEMA_RESERVE_TOKENS=1024
CONTEXT_JIT_MAX_CALLS=3
CONTEXT_JIT_MAX_TOKENS_PER_CALL=1600
CONTEXT_COMPACTION_ENABLED=true
CONTEXT_CACHE_ENABLED=true
# 可选：本机已缓存的 HuggingFace tokenizer 路径或模型名；为空时使用显式标记的估算器。
CONTEXT_TOKENIZER_MODEL=
INTERVIEW_RAG_MAX_QUESTIONS=10
INTERVIEW_RAG_ANSWER_BATCH_SIZE=10
INTERVIEW_RAG_LLM_CONCURRENCY=2
INTERVIEW_RAG_VERIFY_QUESTION_BATCH_SIZE=10
INTERVIEW_RAG_VERIFY_MAX_TOKENS=2800
INTERVIEW_RAG_JSON_REPAIR_ATTEMPTS=1
INTERVIEW_RAG_RETRIEVAL_TOP_N=20
INTERVIEW_RAG_EVIDENCE_TOP_K=5
INTERVIEW_RAG_EVIDENCE_CHARS=360
INTERVIEW_RAG_ANSWER_REPAIR_ATTEMPTS=2
INTERVIEW_RAG_MAX_LLM_CALLS=8
INTERVIEW_RAG_MAX_PROMPT_CHARS=100000
INTERVIEW_RAG_MAX_COMPLETION_TOKENS=15000
ADMIN_API_KEY=
REQUIRE_ADMIN_FOR_MUTATIONS=false

UPLOAD_DIR=data/uploads
EXPORT_DIR=data/exports
CHROMA_DIR=data/chroma
# 本地开发使用 sqlite；生产多实例必须改为 postgres 并提供共享 DSN。
LANGGRAPH_CHECKPOINT_BACKEND=sqlite
LANGGRAPH_CHECKPOINT_FILE=data/runtime/langgraph_checkpoints.sqlite
LANGGRAPH_CHECKPOINT_POSTGRES_DSN=
CHUNK_SIZE=900
CHUNK_OVERLAP=160
PDF_MAX_UPLOAD_MB=15
PDF_MAX_PAGES=30
PDF_MIN_TEXT_CHARS_PER_PAGE=24
PDF_MIN_PRINTABLE_RATIO=0.75
PDF_MIN_ALNUM_RATIO=0.35
PDF_MAX_REPLACEMENT_RATIO=0.01
PDF_OCR_ENABLED=true
PDF_OCR_DPI=200
PDF_OCR_MIN_CONFIDENCE=0.45
PDF_MAX_RENDER_PIXELS=20000000
PDF_CROSS_PAGE_TAIL_CHARS=260
PDF_CROSS_PAGE_HEAD_CHARS=520
EMBEDDING_DIMENSIONS=256
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_PROVIDER_FALLBACK=error
VECTOR_BACKEND=hybrid
RERANKER_ENABLED=true
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_PROVIDER_FALLBACK=error
RERANKER_TOP_N=20
RERANKER_ANCHOR_TOP_N=5
JOB_INGEST_CONCURRENCY=6
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=career_agent:runs
REDIS_DEAD_LETTER_QUEUE_NAME=career_agent:runs:dead_letter
REDIS_RUN_LOCK_TTL_SECONDS=1800
REDIS_HEARTBEAT_TTL_SECONDS=300
REDIS_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_RATE_LIMIT_MAX_RUNS=10
REDIS_WORKER_MAX_ATTEMPTS=3
REDIS_QUEUED_RECOVERY_AFTER_MINUTES=5
AGENT_RUN_MAX_RECOVERY_ATTEMPTS=3
AGENT_RUN_STALE_AFTER_MINUTES=30
AGENT_ACTIVE_RUN_LIMIT_PER_PROFILE=3

# 可选岗位源配置。
TENCENT_CAREERS_ENABLED=true
BAIDU_CAREERS_ENABLED=true
MEITUAN_CAREERS_ENABLED=true
BYTEDANCE_CAREERS_ENABLED=true
ALIBABA_CAREERS_ENABLED=true
JD_CAREERS_ENABLED=true
CHINA_TELECOM_CAREERS_ENABLED=true
HUAWEI_CAREERS_ENABLED=true
IFLYTEK_CAREERS_ENABLED=true
TCL_CAREERS_ENABLED=true
MIDEA_CAREERS_ENABLED=true
XIAOMI_CAREERS_ENABLED=true
SKYWORTH_CAREERS_ENABLED=true
WIND_CAREERS_ENABLED=true
MOKA_CHINA_CAREERS_ENABLED=true
DIDI_CAREERS_ENABLED=true
HONOR_CAREERS_ENABLED=true
KUAISHOU_CAREERS_ENABLED=true
LENOVO_CAREERS_ENABLED=true
VIVO_CAREERS_ENABLED=true
NETEASE_CAREERS_ENABLED=true
MINIMAX_CAREERS_ENABLED=true
ZHIPU_CAREERS_ENABLED=true
JOB_SOURCE_BROWSER_HEADLESS=true
JOB_SOURCE_BROWSER_TIMEOUT_MS=30000
LEVER_CAREERS_ENABLED=false
LEVER_COMPANY_SLUGS=anthropic,cohere,scaleai,perplexityai
