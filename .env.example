APP_NAME=CareerAgent
APP_ENV=development
DATABASE_URL=sqlite:///./data/career_agent.db

# OpenAI-compatible LLM endpoint. Do not commit real secrets in .env.
LLM_API_KEY=
LLM_BASE_URL=https://llmapi.paratera.com
LLM_MODEL=DeepSeek-V4-Pro

UPLOAD_DIR=data/uploads
EXPORT_DIR=data/exports
CHUNK_SIZE=900
CHUNK_OVERLAP=160
EMBEDDING_DIMENSIONS=256

# Optional job source knobs.
TENCENT_CAREERS_ENABLED=true
LEVER_COMPANY_SLUGS=anthropic,cohere,scaleai,perplexityai
